# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/restaurant_db
DATABASE_URL_SYNC=postgresql://postgres:postgrespassword@localhost:5432/restaurant_db

# Security & JWT
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173